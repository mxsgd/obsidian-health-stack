# Copy to .env and adjust. .env is gitignored.
JOURNAL_DIR=C:\path\to\ObsidianVault\Food Journal

# FatSecret: platform.fatsecret.com > API keys, the OAuth 1.0 pair (not the OAuth 2.0 client secret)
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_SINCE=2026-01-01
# FATSECRET_TOKEN / FATSECRET_TOKEN_SECRET are appended by `uv run python -m extract.fatsecret`
